{
  "name": "dsh-opencode-go-second",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Independent OpenCode Go second connection for DeepSeek Harness",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true,
      "external": [
        "react"
      ]
    }
  }
}
