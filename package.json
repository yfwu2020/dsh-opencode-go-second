{
  "name": "dsh-opencode-go-second",
  "version": "0.3.2",
  "type": "module",
  "description": "Independent OpenCode Go second connection for DeepSeek Harness",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.2.2-0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0"
  },
  "devDependencies": {
    "yaml": "2.8.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true,
      "external": [
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfwu2020/dsh-opencode-go-second.git"
  },
  "homepage": "https://github.com/yfwu2020/dsh-opencode-go-second#readme",
  "bugs": {
    "url": "https://github.com/yfwu2020/dsh-opencode-go-second/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "opencode-go",
    "llm-provider"
  ],
  "files": [
    "index.mjs",
    "profiles.mjs",
    "catalog.mjs",
    "catalog-store.mjs",
    "discovery.mjs",
    "json-response.mjs",
    "go-stream.mjs",
    "client.js",
    "cordis.patch.yml",
    "data/"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
